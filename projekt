# =============================================================================
# Algen-IoT - Python Package Configuration
# =============================================================================
# Modernes Python-Packaging mit pyproject.toml (PEP 621).
# Installation als editierbares Paket:
#     pip install -e .
# Installation mit Dev-Tools:
#     pip install -e ".[dev]"
# =============================================================================

[build-system]
requires = ["setuptools>=68.0", "wheel"]
build-backend = "setuptools.build_meta"


[project]
name = "algen-iot"
version = "1.0.0"
description = "Photobioreaktor-IoT-System: Sensorik, Aktorik, Analyse und Steuerung fuer Chlorella-vulgaris-Kultivierung"
readme = "README.md"
license = {file = "LICENSE"}
requires-python = ">=3.11"
authors = [
    {name = "Algen-IoT Team"},
]
keywords = ["iot", "raspberry-pi", "mqtt", "influxdb", "photobioreactor", "algae"]
classifiers = [
    "Development Status :: 4 - Beta",
    "Intended Audience :: Science/Research",
    "Operating System :: POSIX :: Linux",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "Topic :: Scientific/Engineering",
    "Topic :: System :: Hardware",
]

# Laufzeit-Abhaengigkeiten (Pflicht auf dem Pi)
dependencies = [
    "paho-mqtt>=2.0.0",
    "influxdb-client>=1.40.0",
]


[project.optional-dependencies]
# Hardware-Treiber - nur auf dem Pi installieren
pi = [
    "RPi.GPIO>=0.7.1",
    "w1thermsensor>=2.0.0",
    "adafruit-circuitpython-ccs811>=1.3.0",
    "adafruit-circuitpython-dht>=4.0.0",
    "gpiozero>=2.0",
    "spidev>=3.6",
]

# Dev-Werkzeuge fuer lokale Entwicklung
dev = [
    "pytest>=7.4.0",
    "pytest-cov>=4.1.0",
    "pytest-mock>=3.12.0",
    "ruff>=0.1.0",
    "mypy>=1.7.0",
    "black>=23.0.0",
]


[project.scripts]
# Damit nach "pip install" die Skripte direkt aufrufbar sind:
#     algen-capture-reactor
#     algen-analyze-air
#     ...
algen-capture-reactor      = "algen_iot_scripts.capture_reactor_sensors:main"
algen-capture-room         = "algen_iot_scripts.capture_room_climate:main"
algen-capture-actuators    = "algen_iot_scripts.capture_hardware_actuators:main"
algen-analyze-algae        = "algen_iot_scripts.analyze_algae_vitality:main"
algen-analyze-air          = "algen_iot_scripts.analyze_air_quality:main"
algen-control-actuators    = "algen_iot_scripts.control_actuator_logic:main"
algen-bridge-actuator      = "algen_iot_scripts.bridge_andanalyse_mqtt_actuator_status:main"
algen-bridge-dashboard     = "algen_iot_scripts.bridge_db_to_dashboard:main"
algen-bridge-alerts        = "algen_iot_scripts.bridge_dashboard_alerts:main"
algen-notify-email         = "algen_iot_scripts.notify_email_service:main"


[project.urls]
Homepage = "https://github.com/IHR-USER/algen-iot"
Documentation = "https://github.com/IHR-USER/algen-iot/tree/main/docs"
Issues = "https://github.com/IHR-USER/algen-iot/issues"


# =============================================================================
# setuptools-spezifisches: "src layout"
# =============================================================================
[tool.setuptools.packages.find]
where = ["src"]
include = ["algen_iot_core*", "algen_iot_scripts*"]


# =============================================================================
# Test-Konfiguration
# =============================================================================
[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
python_functions = ["test_*"]
addopts = [
    "-v",
    "--strict-markers",
    "--cov=algen_iot_core",
    "--cov-report=term-missing",
    "--cov-fail-under=70",
]


# =============================================================================
# Linter / Formatter
# =============================================================================
[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "N", "UP", "B", "SIM", "PL", "RUF"]
ignore = ["PLR0913"]  # too-many-arguments akzeptieren

[tool.black]
line-length = 100
target-version = ["py311"]

[tool.mypy]
python_version = "3.11"
warn_return_any = true
warn_unused_configs = true
ignore_missing_imports = true  # RPi.GPIO etc. haben keine Typen
